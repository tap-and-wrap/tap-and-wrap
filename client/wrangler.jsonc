{
  "name": "tapandwrap-frontend",
  "workers_dev": false,
  "preview_urls": false,
  "main": "./worker/seo-worker.js",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/assets/*", "!/tap-wrap-logo.webp"]
  },
  "vars": {
    "SEO_INDEXING_ENABLED": "false",
    "SEO_EXPECTED_PUBLICATION_ID": "",
    "SEO_WITHDRAWN_PATHS": "",
    "BROWSER_CSP_MODE": "report-only",
    "BROWSER_API_ORIGINS": "",
    "BROWSER_MEDIA_ORIGINS": "",
    "BROWSER_UPLOAD_ORIGINS": "",
    "BROWSER_TRACKING_ALLOWED": "false"
  }
}
