NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/tapandwrap_dev
DATABASE_TARGET=local
# Staging requires DATABASE_TARGET=staging and the exact tapandwrap_staging database.
# Enable only after authorized staging setup. Authorization is still required.
STAGING_PREVIEW_ENABLED=false
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET_BEFORE_AUTH_TESTING
CHECKOUT_ENABLED=false
COMMERCE_LAUNCH_AUTHORIZED=false
# Private customer files. Keep disabled until an authorized isolated R2 setup.
STORAGE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Durable order notifications. Staging delivery requires explicit safe recipients.
NOTIFICATIONS_ENABLED=false
EMAIL_PROVIDER=gmail
EMAIL_ENABLED=false
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Tap & Wrap
EMAIL_SMOKE_TEST_ENABLED=false
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_SAFE_RECIPIENTS=
NOTIFICATION_LIVE_DELIVERY_ENABLED=false
# Optional tracking requires owner-approved policy, explicit consent and launch configuration.
META_ENABLED=false
META_POLICY_APPROVED=false
META_CAPI_ENABLED=false
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_API_VERSION=
META_CONSENT_POLICY_VERSION=
SITE_ORIGIN=
# Optional approved public media origin. Leave blank until media keys are mapped.
# No uploads occur when this is configured; never use a local filesystem URL.
CATALOG_MEDIA_BASE_URL=
